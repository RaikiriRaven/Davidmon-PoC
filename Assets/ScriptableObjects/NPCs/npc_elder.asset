  m_Name: npc_elder
  m_EditorClassIdentifier: Assembly-CSharp::Davidmon.NPC.NpcData
  npcId: npc_elder
  displayName: Village Elder
  title: Elder of Sunderglen
  description: "Village Elder \u2014 Elder of Sunderglen"
  robeColor: {r: 0.13, g: 0.35, b: 0.3, a: 1}
  skinColor: {r: 0.95, g: 0.8, b: 0.65, a: 1}
  hasHat: 1
  prefab: {fileID: 0}
  interactionHint: Talk
  interactRadius: 3.5
  introLines:
  - speaker: 
    text: Welcome to Sunderglen, traveler. Sit a while.
  - speaker: 
    text: These wild creatures share the land; they can be fought, but never caught. Train what you begin with.
  - speaker: 
    text: The ruins to the east hold a power this village cannot contain. Grow strong before you face it.
  choices:
  - label: Tell me about the wilds
    action: 0
    reply: Every creature holds a spark of the wild. Befriend one, grow with it, and it will never forsake you.
  - label: I will remember that.
    action: 0
    reply: 
  isHealer: 0
